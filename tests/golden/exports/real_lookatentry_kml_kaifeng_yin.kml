<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
	<name>ExtendedData+SchemaData</name>
	<open>1</open>
	<!-- Create a balloon template referring to the user-defined type -->
	<Style id="entry-balloon-template">
		<BalloonStyle>
			<text>
				<![CDATA[
				$[EntryPerson/PersonNameHZ] <br/>
				ID: $[EntryPerson/PersonID] <br/>
				Index Year: $[EntryPerson/IndexYear] <br/>
				Entry Year: $[EntryPerson/EntryYear] <br/>
				Entry Desc: $[EntryPerson/EntryDesc] <br/>
				Entry Chn: $[EntryPerson/EntryDescHZ] <br/>
				Entry Rank: $[EntryPerson/EntryRank] <br/>
				Address: $[EntryPerson/AddrName] $[EntryPerson/AddrNameHZ] <br/>
				XY Count: $[EntryPerson/XYCount] <br/><br/>
				]]>
			</text>
		</BalloonStyle>
	</Style>
	<!-- Declare the type "EntryPerson" with 10 fields -->
	<Schema name="EntryPerson" id="EntryPersonId">
		<SimpleField type="string" name="PersonNameHZ">
			<displayName><![CDATA[<b>Person</b>]]></displayName>
		</SimpleField>
		<SimpleField type="string" name="AddrName">
			<displayName><![CDATA[<b>Person</b>]]></displayName>
		</SimpleField>
		<SimpleField type="string" name="AddrNameHZ">
			<displayName><![CDATA[<b>Person</b>]]></displayName>
		</SimpleField>
		<SimpleField type="uint" name="PersonID">
			<displayName><![CDATA[ID]]></displayName>
		</SimpleField>
		<SimpleField type="string" name="IndexYear">
			<displayName><![CDATA[Index Year]]></displayName>
		</SimpleField>
		<SimpleField type="int" name="EntryYear">
			<displayName><![CDATA[Entry Year]]></displayName>
		</SimpleField>
		<SimpleField type="string" name="EntryDesc">
			<displayName><![CDATA[Entry Desc]]></displayName>
		</SimpleField>
		<SimpleField type="string" name="EntryDescHZ">
			<displayName><![CDATA[Entry Chn]]></displayName>
		</SimpleField>
		<SimpleField type="int" name="EntryRank">
			<displayName><![CDATA[Entry Rank]]></displayName>
		</SimpleField>
		<SimpleField type="int" name="XYCount">
			<displayName><![CDATA[XY Count]]></displayName>
		</SimpleField>
	</Schema>
	<Placemark>
		<name>Chen Zhizhong</name>
		<styleUrl>#entry-balloon-template</styleUrl>
