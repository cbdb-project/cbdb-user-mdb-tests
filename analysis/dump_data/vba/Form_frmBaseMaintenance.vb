        tTotalNew = tTotalNew + tRecProcessed
        
        ' Rule 16:  Youngest older brother's index year (year + 2)
        tStrCurrent = "YoungestOldestBrother "
    
        cmdSQL.CommandText = "DELETE * FROM TMP_INDEX_YEAR"
        cmdSQL.Execute tRecProcessed
    
