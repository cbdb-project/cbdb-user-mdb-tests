Private Sub build_TMP_ADDR_BELONGS()
    Dim cmdSQL As ADODB.Command, tRecCount As Long
    Dim tStrInsert As String, tStrSelect As String, tStrFrom As String, tStrWhere As String
    
    Set cmdSQL = New ADODB.Command
    cmdSQL.ActiveConnection = CurrentProject.Connection
    cmdSQL.CommandType = adCmdText
    '
    '  Zap the temporaty files
    
    cmdSQL.CommandText = "DELETE * FROM TMP_ADDR_A"
    cmdSQL.Execute tRecCount
    '
    cmdSQL.CommandText = " DELETE * FROM TMP_ADDR_B"
    cmdSQL.Execute tRecCount
    '
    cmdSQL.CommandText = " DELETE * FROM TMP_ADDR_C"
    cmdSQL.Execute tRecCount
    '
    '  Zap ZZZ_ADDRESSES
    '
    cmdSQL.CommandText = " DELETE * FROM ZZZ_ADDRESSES"
    cmdSQL.Execute tRecCount
    '
    'MsgBox "Building TMP_ADDR_A"
    
    '  TMP_ADDR_A begins with all of the address codes and all of the first-order belongs data for those codes
    '  The record count reflects the number of address codes + the number of belongs records for address codes with multiple belongs records
    '
    '  Because the addr_belongs_data can have bad values, I need to use the same set of fixes that I use in later routines
    '
    
    '  Define the basic components (get the address codes without belongs data
    '
    '  first get all the records with no BELONGS
    '
    cmdSQL.CommandText = "INSERT INTO TMP_ADDR_A ( c_addr_id, c_firstyear, c_lastyear ) " + _
        "SELECT ADDR_CODES.c_addr_id, ADDR_CODES.c_firstyear, ADDR_CODES.c_lastyear " + _
        "FROM ADDR_CODES LEFT JOIN ADDR_BELONGS_DATA ON ADDR_CODES.c_addr_id = ADDR_BELONGS_DATA.c_addr_id " + _
        "WHERE (ADDR_BELONGS_DATA.c_addr_id Is Null)"
    '
    cmdSQL.Execute tRecCount
    'MsgBox Str(tRecCount) + " records in E (B2)"
    '
    ' now get those codes that do have data
    '
    cmdSQL.CommandText = "INSERT INTO TMP_ADDR_A ( c_addr_id, c_firstyear, c_lastyear, c_belongs_to, c_belongs_first_year, c_belongs_last_year ) " + _
        "SELECT ADDR_CODES.c_addr_id, ADDR_CODES.c_firstyear, ADDR_CODES.c_lastyear, " + _
            "ADDR_BELONGS_DATA.c_belongs_to, ADDR_BELONGS_DATA.c_firstyear, ADDR_BELONGS_DATA.c_lastyear " + _
        "FROM ADDR_CODES INNER JOIN ADDR_BELONGS_DATA ON ADDR_CODES.c_addr_id = ADDR_BELONGS_DATA.c_addr_id " + _
        "WHERE (ADDR_BELONGS_DATA.c_addr_id Is Not Null)"

    cmdSQL.Execute tRecCount
    
    '  clear out the "Unknown" belongs IDs
    '
    cmdSQL.CommandText = "UPDATE TMP_ADDR_A " + _
        "SET TMP_ADDR_A.c_belongs_to = Null, " + _
            "TMP_ADDR_A.c_belongs_first_year = Null, " + _
            "TMP_ADDR_A.c_belongs_last_year = Null " + _
        "WHERE (TMP_ADDR_A.c_belongs_to = 0)"
    cmdSQL.Execute tRecCount
    '
    '  clear out bad data (1)
    '  If the belongs last year is less than the unit's first year, set the belongs data to Null
    '  If the belongs first year is greater than the unit's last year, set the belongs data to Null
    '
    cmdSQL.CommandText = "UPDATE TMP_ADDR_A " + _
        "SET TMP_ADDR_A.c_belongs_to = Null, " + _
            "TMP_ADDR_A.c_belongs_first_year = Null, " + _
            "TMP_ADDR_A.c_belongs_last_year = Null " + _
        "WHERE (TMP_ADDR_A.c_belongs_last_year < [TMP_ADDR_A].[c_firstyear]) OR (TMP_ADDR_A.c_belongs_first_year > [TMP_ADDR_A].[c_lastyear])"
    cmdSQL.Execute tRecCount

    '  clear out bad data (2)
    '
    cmdSQL.CommandText = "UPDATE TMP_ADDR_A " + _
        "SET TMP_ADDR_A.c_belongs_first_year = [TMP_ADDR_A].[c_firstyear] " + _
        "WHERE (TMP_ADDR_A.c_belongs_first_year < [TMP_ADDR_A].[c_firstyear])"
    cmdSQL.Execute tRecCount
    '
    cmdSQL.CommandText = "UPDATE TMP_ADDR_A " + _
        "SET TMP_ADDR_A.c_belongs_last_year = [TMP_ADDR_A].[c_lastyear] " + _
        "WHERE (TMP_ADDR_A.c_belongs_last_year > [TMP_ADDR_A].[c_lastyear])"
    cmdSQL.Execute tRecCount
    '
    '  now get the years data for the belongs-to units
    '
    cmdSQL.CommandText = "UPDATE TMP_ADDR_A INNER JOIN ADDR_CODES ON TMP_ADDR_A.c_belongs_to = ADDR_CODES.c_addr_id " + _
        "SET TMP_ADDR_A.c_belongs_unit_first_year = [ADDR_CODES].[c_firstyear], " + _
            "TMP_ADDR_A.c_belongs_unit_last_year = [ADDR_CODES].[c_lastyear] "
    cmdSQL.Execute tRecCount

    '  clear out bad data (3)
    '  If the belongs-to unit's first year is greater than the belongs last year, set the belongs data to Null
    '  If the belongs-to unit's last year is less than the belongs first year, set the belongs data to Null
    '
    cmdSQL.CommandText = "UPDATE TMP_ADDR_A " + _
        "SET TMP_ADDR_A.c_belongs_to = Null, " + _
            "TMP_ADDR_A.c_belongs_first_year = Null, " + _
            "TMP_ADDR_A.c_belongs_last_year = Null " + _
        "WHERE (TMP_ADDR_A.c_belongs_unit_first_year > [TMP_ADDR_A].[c_belongs_last_year]) OR " + _
              "(TMP_ADDR_A.c_belongs_unit_last_year < [TMP_ADDR_A].[c_belongs_first_year])"
    cmdSQL.Execute tRecCount

    '  clear out bad data (5)
    '  If the belongs-to unit's first year is greater than the belongs last year, set the belongs data to Null
    '
    cmdSQL.CommandText = "UPDATE TMP_ADDR_A " + _
        "SET TMP_ADDR_A.c_belongs_first_year = [TMP_ADDR_A].[c_belongs_unit_first_year] " + _
        "WHERE (TMP_ADDR_A.c_belongs_unit_first_year > [TMP_ADDR_A].[c_belongs_first_year]) AND " + _
            "(TMP_ADDR_A.c_belongs_last_year >= [TMP_ADDR_A].[c_belongs_unit_first_year])"
    cmdSQL.Execute tRecCount

    '  clear out bad data (6)
    '  If the belongs-to unit's last year is less than the belongs first year, set the belongs data to Null
    '
    cmdSQL.CommandText = "UPDATE TMP_ADDR_A " + _
        "SET TMP_ADDR_A.c_belongs_last_year = [TMP_ADDR_A].[c_belongs_unit_last_year] " + _
        "WHERE (TMP_ADDR_A.c_belongs_last_year > [TMP_ADDR_A].[c_belongs_unit_last_year]) AND " + _
            "(TMP_ADDR_A.c_belongs_first_year <= [TMP_ADDR_A].[c_belongs_unit_last_year])"

    cmdSQL.Execute tRecCount

    '  copy the distinct records to B
    '
    'MsgBox "Building TMP_ADDR_B"
    
    '  TMP_ADDR_B takes the cleaned results from TMP_ADDR_A and just adds names from ADDR_CODES
    
    cmdSQL.CommandText = "INSERT INTO TMP_ADDR_B (c_addr_id, c_belongs_to, c_belongs_first_year, c_belongs_last_year, c_del) " + _
        "SELECT DISTINCT TMP_ADDR_A.c_addr_id, TMP_ADDR_A.c_belongs_to, " + _
            "TMP_ADDR_A.c_belongs_first_year, TMP_ADDR_A.c_belongs_last_year, 0 AS c_del  " + _
        "FROM TMP_ADDR_A"
    cmdSQL.Execute tRecCount
    
    cmdSQL.CommandText = "UPDATE ADDR_CODES INNER JOIN TMP_ADDR_B ON ADDR_CODES.c_addr_id = TMP_ADDR_B.c_addr_id " + _
        "SET TMP_ADDR_B.c_firstyear = [ADDR_CODES].[c_firstyear], " + _
            "TMP_ADDR_B.c_lastyear = [ADDR_CODES].[c_lastyear], " + _
            "TMP_ADDR_B.c_admin_type = [ADDR_CODES].[c_admin_type], " + _
            "TMP_ADDR_B.x_coord = [ADDR_CODES].[x_coord], " + _
            "TMP_ADDR_B.y_coord = [ADDR_CODES].[y_coord] "
    cmdSQL.Execute tRecCount
    
    cmdSQL.CommandText = "UPDATE TMP_ADDR_B INNER JOIN ADDR_CODES ON TMP_ADDR_B.c_belongs_to = ADDR_CODES.c_addr_id " + _
        "SET TMP_ADDR_B.c_belongs_name = ADDR_CODES.c_name, " + _
            "TMP_ADDR_B.c_belongs_chn = ADDR_CODES.c_name_chn "
    cmdSQL.Execute tRecCount
    'MsgBox Str(tRecCount) + " records in B"
    '
    '  now delete the records where the belong ID were zapped, when other belong records are available
    '
    cmdSQL.CommandText = "UPDATE TMP_ADDR_B AS TMP_ADDR_B_1 INNER JOIN TMP_ADDR_B ON TMP_ADDR_B_1.c_addr_id = TMP_ADDR_B.c_addr_id " + _
        "SET TMP_ADDR_B.c_del = 1 " + _
        "WHERE ((TMP_ADDR_B.c_belongs_to Is Null) AND (TMP_ADDR_B_1.c_belongs_to > 0))"
    cmdSQL.Execute tRecCount
    '
    '  remove the records
    '
    cmdSQL.CommandText = " DELETE * FROM TMP_ADDR_B WHERE c_del = 1"
    cmdSQL.Execute tRecCount
    'MsgBox Str(tRecCount) + " records removed from B"
    '
    '  now get the highest end year for belongs relations for each unit
    '  What we are looking for is whether there is a period in which the administrative unit exists (either at the beginning or the end
    '     in which no BELONGS relations are defined.  So, the query looks at all possible belongs record to see the earliest and latest values
    '     If it finds any gaps, it adds those gaps to B with no belongs ID assigned
    '
    '
    '  copy the results into the TMP_ADDR_BELONGS_TO table
    '  I have changed the code so that the first and last years are the BELONGS first and last years
    '
    cmdSQL.CommandText = " DELETE * FROM TMP_ADDR_BELONGS"
    cmdSQL.Execute tRecCount
    '
    cmdSQL.CommandText = "INSERT INTO TMP_ADDR_BELONGS ( c_addr_id, c_firstyear, c_lastyear, " + _
            "c_admin_type, x_coord, y_coord, belongs_to_ID, belongs_to_chn, belongs_to_py ) " + _
        "SELECT DISTINCT TMP_ADDR_B.c_addr_id, TMP_ADDR_B.c_belongs_first_year, " + _
            "TMP_ADDR_B.c_belongs_last_year, TMP_ADDR_B.c_admin_type, TMP_ADDR_B.x_coord, TMP_ADDR_B.y_coord, " + _
            "TMP_ADDR_B.c_belongs_to, TMP_ADDR_B.c_belongs_chn, ADDR_CODES.c_name AS belongs_to_py " + _
        "FROM TMP_ADDR_B LEFT JOIN ADDR_CODES ON TMP_ADDR_B.c_belongs_to = ADDR_CODES.c_addr_id"
    cmdSQL.Execute tRecCount
    'MsgBox Str(tRecCount) + " records in TMP_ADDR_BELONGS"
    '
    '  add the first and last years from ADDR_CODES when no other data is there
    cmdSQL.CommandText = "UPDATE TMP_ADDR_BELONGS INNER JOIN ADDR_CODES ON TMP_ADDR_BELONGS.c_addr_id = ADDR_CODES.c_addr_id " + _
        "SET TMP_ADDR_BELONGS.c_firstyear = [ADDR_CODES].[c_firstyear], " + _
            "TMP_ADDR_BELONGS.c_lastyear = [ADDR_CODES].[c_lastyear] " + _
        "WHERE ((TMP_ADDR_BELONGS.c_firstyear Is Null) AND (TMP_ADDR_BELONGS.c_lastyear Is Null))"
    cmdSQL.Execute tRecCount
    '
    cmdSQL.CommandText = "UPDATE TMP_ADDR_BELONGS INNER JOIN ADDR_CODES ON TMP_ADDR_BELONGS.c_addr_id = ADDR_CODES.c_addr_id " + _
        "SET TMP_ADDR_BELONGS.c_name = [ADDR_CODES].[c_name], " + _
            "TMP_ADDR_BELONGS.c_name_chn = [ADDR_CODES].[c_name_chn] "
    cmdSQL.Execute tRecCount
    '
    '  TMP_ADDR_B now has all the valid unit belongs relations:  we use it to build ZZZ_ADDRESSES
End Sub
Private Sub build_address_B1_B2_SQL()
    Dim cmdSQL As ADODB.Command, tRecCount As Long
    Dim tStrInsert As String, tStrSelectBase As String, tStrSelect As String, tStrFrom As String, tStrWhere As String
    
    Set cmdSQL = New ADODB.Command
    cmdSQL.ActiveConnection = CurrentProject.Connection
    cmdSQL.CommandType = adCmdText
    '
    '  Zap the temporaty files
    
    cmdSQL.CommandText = "DELETE * FROM TMP_ADDR_D"
    cmdSQL.Execute tRecCount
    '
    cmdSQL.CommandText = "DELETE * FROM TMP_ADDR_E"
    cmdSQL.Execute tRecCount
    '
    '  Copy TMP_ADDR_B into TMP_ADDR_D, which has the same structure as ZZZ_ADDRESSES
    '
    '  Note that tmpADDRESSES has two extra fields needed for comparison
    '
    'MsgBox "B1-B2: Finishing 1"
    cmdSQL.CommandText = "INSERT INTO TMP_ADDR_D ( c_addr_id, c_firstyear, c_lastyear, c_admin_type, " + _
            "x_coord, y_coord, belongs1_ID, belongs1_first_year, belongs1_last_year, belongs_first_year, belongs_last_year ) " + _
        "SELECT DISTINCT TMP_ADDR_B.c_addr_id, TMP_ADDR_B.c_firstyear, " + _
            "TMP_ADDR_B.c_lastyear, TMP_ADDR_B.c_admin_type, TMP_ADDR_B.x_coord, TMP_ADDR_B.y_coord, " + _
            "TMP_ADDR_B.c_belongs_to, TMP_ADDR_B.c_belongs_first_year, TMP_ADDR_B.c_belongs_last_year, TMP_ADDR_B.c_belongs_first_year, " + _
            "TMP_ADDR_B.c_belongs_last_year " + _
        "FROM TMP_ADDR_B LEFT JOIN ADDR_CODES ON TMP_ADDR_B.c_belongs_to = ADDR_CODES.c_addr_id"
    cmdSQL.Execute tRecCount
    'MsgBox Str(tRecCount) + " records copied from B to D"
    '
    If tRecCount > 200000 Then
        Exit Sub
    End If
    
    '  I have completely redone the logic of this to insert new records only when the belongs to has multiple belongs during the period
    '  now get the next layer (belongs2)
    '
    '  Define the basic components
    '
    '  first get all the records with no BELONGS
    '
    cmdSQL.CommandText = "INSERT INTO TMP_ADDR_E ( c_addr_id, belongs1_ID, belongs1_first_year, belongs1_last_year, belongs_first_year, belongs_last_year ) " + _
        "SELECT DISTINCT TMP_ADDR_D.c_addr_id, TMP_ADDR_D.belongs1_ID, TMP_ADDR_D.belongs1_first_year, TMP_ADDR_D.belongs1_last_year, " + _
            "TMP_ADDR_D.belongs_first_year, TMP_ADDR_D.belongs_last_year " + _
        "FROM TMP_ADDR_D " + _
        "WHERE (TMP_ADDR_D.belongs1_ID Is Null)"
    '
    cmdSQL.Execute tRecCount
    'MsgBox Str(tRecCount) + " records in E (B2)"
    '
    '  next get all the records where the BELONGS has no BELONGS
    '  the problem here is that many addresses in belongs1_ID have two records, one of which has no c_belongs_to
    '  the dates here have to be tested.
    '
