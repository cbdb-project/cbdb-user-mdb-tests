        cmdSQL.Execute tRecProcessed
        tTotalNew = tTotalNew + tRecProcessed
        
        ' Rule 19:  FATHER'S FATHER'S index year (year + 59)
        tStrCurrent = "FatherOfFather "
        
        '           The initial algorithm took a max of the birth years, and there are 4 people in the database who have 2 separate records for FF
        '           The max code approach has been commented out but can replace the direct version if necessary
        
        cmdSQL.CommandText = "UPDATE BIOG_MAIN AS BIOG_MAIN_1 INNER JOIN (BIOG_MAIN INNER JOIN KIN_DATA ON BIOG_MAIN.c_personid = KIN_DATA.c_kin_id) " + _
            "ON BIOG_MAIN_1.c_personid = KIN_DATA.c_personid " + _
