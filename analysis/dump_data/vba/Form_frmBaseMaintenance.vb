Private Sub GetIndexYearSQL()

    Dim tStrQuery(30, 4) As String, tTotal As Long, ti As Integer, tMax As Integer
    Dim cmdSQL As ADODB.Command, tRecProcessed As Long
    
    Set cmdSQL = New ADODB.Command
    cmdSQL.ActiveConnection = CurrentProject.Connection
    cmdSQL.CommandType = adCmdText
    '
    cmdSQL.CommandText = "Delete * from tmpIndexYear"
    cmdSQL.Execute tRecProcessed

    ' Rule 1 (two parts:  where the person died at age < 60, and where they died at age >= 60)
    
    tStrQuery(1, 1) = "INSERT INTO tmpIndexYear ( c_index_year, c_personid ) " + _
        "SELECT BIOG_MAIN.c_deathyear, BIOG_MAIN.c_personid " + _
        "FROM BIOG_MAIN " + _
        "WHERE (((BIOG_MAIN.c_index_year) Is Null Or (BIOG_MAIN.c_index_year)=0) AND " + _
        "((BIOG_MAIN.c_birthyear)>=[BIOG_MAIN].[c_deathyear]-60) AND ((BIOG_MAIN.c_deathyear)>0))"
        
    tStrQuery(1, 2) = "UPDATE BIOG_MAIN INNER JOIN tmpIndexYear ON BIOG_MAIN.c_personid = tmpIndexYear.c_personid " + _
        "SET BIOG_MAIN.c_index_year = [tmpIndexYear].[c_index_year], " + _
