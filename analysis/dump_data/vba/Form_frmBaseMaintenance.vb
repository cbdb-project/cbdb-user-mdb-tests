Private Sub Date_Time_table_update()
    Dim TableName(19) As String, ti As Integer, tQueryStr As String
    Dim cmdSQL As ADODB.Command, tRecNum As Long

    Set cmdSQL = New ADODB.Command
    cmdSQL.ActiveConnection = CurrentProject.Connection
    cmdSQL.CommandType = adCmdText
    '
    ' define the tables to be fixed
    
    TableName(1) = "ADDR_BELONGS_DATA"
    TableName(2) = "ALTNAME_DATA"
    TableName(3) = "ASSOC_DATA"
    TableName(4) = "BIOG_ADDR_DATA"
    TableName(5) = "BIOG_INST_DATA"
    TableName(6) = "BIOG_MAIN"
    TableName(7) = "BIOG_SOURCE_DATA"
    TableName(8) = "BIOG_TEXT_DATA"
    TableName(9) = "ENTRY_DATA"
    TableName(10) = "EVENTS_DATA"
    TableName(11) = "KIN_DATA"
    TableName(12) = "MERGED_PERSON_DATA"
    TableName(13) = "POSSESSION_DATA"
    TableName(14) = "POSTED_TO_ADDR_DATA"
    TableName(15) = "POSTED_TO_OFFICE_DATA"
    TableName(16) = "POSTING_DATA"
    TableName(17) = "STATUS_DATA"
    TableName(18) = "TEXT_CODES"
    TableName(19) = "TEXT_INSTANCE_DATA"
    
    ti = 2
    
    Do While ti < 20
        '
        MsgBox "Processing " + Str(ti) + " " + TableName(ti)
        
        ' update their values
        
        cmdSQL.CommandText = "UPDATE " + TableName(ti) + " " + _
            "SET " + TableName(ti) + ".c_created_date_ISO = DateSerial(Left([" + TableName(ti) + "].[c_created_date], 4), " + _
                "Mid([" + TableName(ti) + "].[c_created_date], 5, 2), Right([" + TableName(ti) + "].[c_created_date], 2) ) " + _
            "WHERE (" + TableName(ti) + ".c_created_date is not NULL AND Len([c_created_date]) = 8)"
        
        cmdSQL.Execute tRecNum

        cmdSQL.CommandText = "UPDATE " + TableName(ti) + " " + _
            "SET " + TableName(ti) + ".c_modified_date_ISO = DateSerial(Left([" + TableName(ti) + "].[c_modified_date], 4), " + _
                "Mid([" + TableName(ti) + "].[c_modified_date], 5, 2), Right([" + TableName(ti) + "].[c_modified_date], 2) ) " + _
            "WHERE (" + TableName(ti) + ".c_modified_date is not NULL AND Len([c_modified_date]) = 8)"
        cmdSQL.Execute tRecNum

        
        ti = ti + 1
    Loop

End Sub
Private Sub Date_Time_table_rename()
    Dim TableName(19) As String, ti As Integer, tQueryStr As String
    Dim cmdSQL As ADODB.Command, tRecNum As Long

    Set cmdSQL = New ADODB.Command
    cmdSQL.ActiveConnection = CurrentProject.Connection
    cmdSQL.CommandType = adCmdText
    '
    ' define the tables to be fixed
    
    TableName(1) = "ADDR_BELONGS_DATA"
    TableName(2) = "ALTNAME_DATA"
    TableName(3) = "ASSOC_DATA"
    TableName(4) = "BIOG_ADDR_DATA"
    TableName(5) = "BIOG_INST_DATA"
    TableName(6) = "BIOG_MAIN"
    TableName(7) = "BIOG_SOURCE_DATA"
    TableName(8) = "BIOG_TEXT_DATA"
    TableName(9) = "ENTRY_DATA"
    TableName(10) = "EVENTS_DATA"
    TableName(11) = "KIN_DATA"
    TableName(12) = "MERGED_PERSON_DATA"
    TableName(13) = "POSSESSION_DATA"
    TableName(14) = "POSTED_TO_ADDR_DATA"
    TableName(15) = "POSTED_TO_OFFICE_DATA"
    TableName(16) = "POSTING_DATA"
    TableName(17) = "STATUS_DATA"
    TableName(18) = "TEXT_CODES"
    TableName(19) = "TEXT_INSTANCE_DATA"
    
    ti = 2
    
    Do While ti < 20
        '
        MsgBox "Processing " + Str(ti) + " " + TableName(ti)
        
        ' drop the old fields
        
        cmdSQL.CommandText = "ALTER TABLE " + TableName(ti) + " DROP COLUMN c_created_date"
        cmdSQL.Execute tRecNum
        
        cmdSQL.CommandText = "ALTER TABLE " + TableName(ti) + " DROP COLUMN c_modified_date"
        cmdSQL.Execute tRecNum
        
        ' rename the new fields
        
        ' there is no elegant way to do this: one has to add the new columns, copy the data, and then drop the old columns
        
        ' (1) Add new
        
        cmdSQL.CommandText = "ALTER TABLE " + TableName(ti) + " ADD COLUMN c_created_date DATE"
        cmdSQL.Execute tRecNum
        
        cmdSQL.CommandText = "ALTER TABLE " + TableName(ti) + " ADD COLUMN c_modified_date DATE"
        cmdSQL.Execute tRecNum
        
        ' (2) Update new from old
        
        cmdSQL.CommandText = "UPDATE " + TableName(ti) + " " + _
            "SET " + TableName(ti) + ".c_created_date = " + TableName(ti) + ".[c_created_date_ISO] "
        cmdSQL.Execute tRecNum

        cmdSQL.CommandText = "UPDATE " + TableName(ti) + " " + _
            "SET " + TableName(ti) + ".c_modified_date = " + TableName(ti) + ".[c_modified_date_ISO] "
        cmdSQL.Execute tRecNum
        
        ' (3) Drop old
        
        cmdSQL.CommandText = "ALTER TABLE " + TableName(ti) + " DROP COLUMN c_created_date_ISO"
        cmdSQL.Execute tRecNum
        
        cmdSQL.CommandText = "ALTER TABLE " + TableName(ti) + " DROP COLUMN c_modified_date_ISO"
        cmdSQL.Execute tRecNum
        
        ti = ti + 1
    Loop

End Sub