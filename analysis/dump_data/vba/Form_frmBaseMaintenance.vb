                "BIOG_MAIN_1.c_index_year_source_id = [BIOG_MAIN].[c_personid] " + _
            "WHERE (((BIOG_MAIN.c_birthyear)>-400) AND ((BIOG_MAIN_1.c_index_year) Is Null) AND ((KIN_DATA.c_kin_code)=62) )"
        cmdSQL.Execute tRecProcessed
        tStrCurrent = "FinishedLoop "
        tTotalNew = tTotalNew + tRecProcessed
        
        tTotal = tTotal + tTotalNew
        
        MsgBox Str(tTotalNew) + " additional index years derived."
        
        tLoopCount = tLoopCount + 1

    Loop
    
Exit_GetBirthIndex:
    MsgBox Str(tTotal) + " total records updated"
    Exit Sub

ErrorGetBirthIndex:
    MsgBox tStrCurrent + Err.Description
    Resume Exit_GetBirthIndex
    
End Sub


Private Sub CmdNames_Click()
    Dim tStrInertSQL As String, tStrSelectSQL As String, tStrFromSQL As String
    
     Dim tRstSearch As DAO.Recordset, tstr As String, tQt As String, tQuery As QueryDef
    Dim cmdSQL As ADODB.Command, tRecNum As Long
    
    ' the logic of search is to use the characters first, then the pinyin
    ' the search first looks at BIOG_MAIN's c_name and c_name_chn
    ' it then looks at c_name_proper and c_name_rm in BIOG_MAIN
    ' then it looks at ZZZ_ALTNAMES
    
    Set cmdSQL = New ADODB.Command
    cmdSQL.ActiveConnection = CurrentProject.Connection
    cmdSQL.CommandType = adCmdText
    '
    cmdSQL.CommandText = "Delete * from ZZZ_NAMES"
    cmdSQL.Execute tRecNum
    
    ' now populate from BIOG_MAIN
    
    cmdSQL.CommandText = "INSERT INTO ZZZ_NAMES ( c_personid, c_name, c_name_chn ) SELECT c_personid, c_name, c_name_chn FROM BIOG_MAIN"
    cmdSQL.Execute tRecNum
    
    '  now look in ALTNAME:  this just machanically adds the xing and ming
    
    cmdSQL.CommandText = "INSERT INTO ZZZ_NAMES ( c_personid, c_name, c_name_chn ) " + _
        "SELECT ALTNAME_DATA.c_personid, BIOG_MAIN.c_surname + ' '+ ALTNAME_DATA.c_alt_name AS c_name, " + _
        "BIOG_MAIN.c_surname_chn + ALTNAME_DATA.c_alt_name_chn AS c_name_chn " + _
        "FROM BIOG_MAIN INNER JOIN ALTNAME_DATA ON BIOG_MAIN.c_personid = ALTNAME_DATA.c_personid"
    cmdSQL.Execute tRecNum
        
End Sub
