        ' Rule 18W:  Oldest son-in-law's birthday (female) (year - 27 + 3)
        tStrCurrent = "OldestSonInLaw-female "
        
        cmdSQL.CommandText = "DELETE * FROM TMP_INDEX_YEAR"
        cmdSQL.Execute tRecProcessed
    
        cmdSQL.CommandText = "INSERT INTO TMP_INDEX_YEAR ( c_personid, c_index_year ) " + _
            "SELECT BIOG_MAIN.c_personid, Min(BIOG_MAIN_1.c_index_year) AS MinOfc_index_year " + _
            "FROM BIOG_MAIN AS BIOG_MAIN_1 INNER JOIN (BIOG_MAIN INNER JOIN KIN_DATA ON " + _
                "BIOG_MAIN.c_personid = KIN_DATA.c_personid) ON BIOG_MAIN_1.c_personid = KIN_DATA.c_kin_id " + _
            "WHERE (((BIOG_MAIN.c_index_year) Is Null ) And " + _
                "((KIN_DATA.c_kin_code) = 181 Or (KIN_DATA.c_kin_code) = 201 Or " + _
