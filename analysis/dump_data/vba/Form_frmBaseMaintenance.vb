                    "belongs3_ID, belongs3_first_year, belongs3_last_year, " + _
                    "belongs4_ID, belongs4_first_year, belongs4_last_year, " + _
                    "belongs_first_year, belongs_last_year ) "
    tStrSelect = "SELECT TMP_ADDR_E.c_addr_id, TMP_ADDR_E.belongs1_ID, TMP_ADDR_E.belongs1_first_year, TMP_ADDR_E.belongs1_last_year, " + _
