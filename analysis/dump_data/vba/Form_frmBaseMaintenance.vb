    Dim strSQL As String
    Dim cmdSQL As ADODB.Command, tRecNum As Long
    
    Set cmdSQL = New ADODB.Command
    cmdSQL.ActiveConnection = CurrentProject.Connection
    cmdSQL.CommandType = adCmdText
    
    ' clear the ZZZ_BELONGS_TO table
    
    cmdSQL.CommandText = "DELETE * FROM ZZZ_BELONGS_TO"
    cmdSQL.Execute tRecNum
    '
    '  Because TMP_ADDR_A has basically the same structure as ZZZ_BELONGS_TO,
    '  I copy the data from TMP_ADDR_E to TMP_ADDR_A and then transfer it DISTINCT at the end
    
    cmdSQL.CommandText = "DELETE * FROM TMP_ADDR_A"
    cmdSQL.Execute tRecNum
    '
    '  start with the ADDR_ID itself (copy all records from ADDR_CODES)
    '
    MsgBox "ZZZ_BELONGS 1"
    strSQL = "INSERT INTO TMP_ADDR_A ( c_belongs_to, c_addr_id, c_firstyear, c_lastyear ) " + _
                "SELECT DISTINCT ADDR_CODES.c_addr_id, ADDR_CODES.c_addr_id, ADDR_CODES.c_firstyear, ADDR_CODES.c_lastyear " + _
                "FROM ADDR_CODES " + _
                "WHERE ADDR_CODES.c_addr_id > 0"

    cmdSQL.CommandText = strSQL
    cmdSQL.Execute tRecNum

    strSQL = "INSERT INTO TMP_ADDR_A ( c_belongs_to, c_addr_id, c_firstyear, c_lastyear ) " + _
        "SELECT DISTINCT TMP_ADDR_E.belongs1_ID, TMP_ADDR_E.c_addr_id, TMP_ADDR_E.belongs1_first_year, TMP_ADDR_E.belongs1_last_year " + _
        "FROM TMP_ADDR_E WHERE (TMP_ADDR_E.belongs1_ID Is Not Null)"
    
    cmdSQL.CommandText = strSQL
    cmdSQL.Execute tRecNum
    
    strSQL = "INSERT INTO TMP_ADDR_A ( c_belongs_to, c_addr_id, c_firstyear, c_lastyear ) " + _
        "SELECT DISTINCT TMP_ADDR_E.belongs2_ID, TMP_ADDR_E.c_addr_id, TMP_ADDR_E.belongs2_first_year, TMP_ADDR_E.belongs2_last_year " + _
        "FROM TMP_ADDR_E WHERE (TMP_ADDR_E.belongs2_ID Is Not Null)"
    
    cmdSQL.CommandText = strSQL
    cmdSQL.Execute tRecNum
    
    strSQL = "INSERT INTO TMP_ADDR_A ( c_belongs_to, c_addr_id, c_firstyear, c_lastyear ) " + _
        "SELECT DISTINCT TMP_ADDR_E.belongs3_ID, TMP_ADDR_E.c_addr_id, TMP_ADDR_E.belongs3_first_year, TMP_ADDR_E.belongs3_last_year " + _
        "FROM TMP_ADDR_E WHERE (TMP_ADDR_E.belongs3_ID Is Not Null)"
    
    cmdSQL.CommandText = strSQL
    cmdSQL.Execute tRecNum
    
    strSQL = "INSERT INTO TMP_ADDR_A ( c_belongs_to, c_addr_id, c_firstyear, c_lastyear ) " + _
        "SELECT DISTINCT TMP_ADDR_E.belongs4_ID, TMP_ADDR_E.c_addr_id, TMP_ADDR_E.belongs4_first_year, TMP_ADDR_E.belongs4_last_year " + _
        "FROM TMP_ADDR_E WHERE (TMP_ADDR_E.belongs4_ID Is Not Null)"
    
    cmdSQL.CommandText = strSQL
    cmdSQL.Execute tRecNum
    
    strSQL = "INSERT INTO TMP_ADDR_A ( c_belongs_to, c_addr_id, c_firstyear, c_lastyear ) " + _
        "SELECT DISTINCT TMP_ADDR_E.belongs5_ID, TMP_ADDR_E.c_addr_id, TMP_ADDR_E.belongs5_first_year, TMP_ADDR_E.belongs5_last_year " + _
        "FROM TMP_ADDR_E WHERE (TMP_ADDR_E.belongs5_ID Is Not Null)"
    
    cmdSQL.CommandText = strSQL
    cmdSQL.Execute tRecNum
    
    ' We still have some problems with duplicate records that I need to clean up
    
    strSQL = "UPDATE TMP_ADDR_A INNER JOIN TMP_ADDR_A AS TMP_ADDR_A_1 ON " + _
        "(TMP_ADDR_A.c_belongs_to = TMP_ADDR_A_1.c_belongs_to) AND (TMP_ADDR_A.c_addr_id = TMP_ADDR_A_1.c_addr_id) " + _
            "SET TMP_ADDR_A_1.c_delete = 1 " + _
            "WHERE ((TMP_ADDR_A_1.c_firstyear>[TMP_ADDR_A].[c_firstyear]) AND (TMP_ADDR_A_1.c_lastyear<[TMP_ADDR_A].[c_lastyear])) OR " + _
                "((TMP_ADDR_A_1.c_firstyear=[TMP_ADDR_A].[c_firstyear]) AND (TMP_ADDR_A_1.c_lastyear<[TMP_ADDR_A].[c_lastyear])) OR " + _
                "((TMP_ADDR_A_1.c_firstyear>[TMP_ADDR_A].[c_firstyear]) AND (TMP_ADDR_A_1.c_lastyear=[TMP_ADDR_A].[c_lastyear]))"

    cmdSQL.CommandText = strSQL
    cmdSQL.Execute tRecNum
    
    cmdSQL.CommandText = " DELETE * FROM TMP_ADDR_A WHERE TMP_ADDR_A.c_delete = 1"
    cmdSQL.Execute tRecNum
    
    ' finally, since I've added the first and last years to the primary key, they cannot be NULL
    
    cmdSQL.CommandText = "UPDATE TMP_ADDR_A SET TMP_ADDR_A.c_firstyear = 0 WHERE (TMP_ADDR_A.c_firstyear Is Null)"
    cmdSQL.Execute tRecNum

    cmdSQL.CommandText = "UPDATE TMP_ADDR_A SET TMP_ADDR_A.c_lastyear = 0 WHERE (TMP_ADDR_A.c_lastyear Is Null)"
    cmdSQL.Execute tRecNum
        
    ' Now copy the results
    
    MsgBox "ZZZ_BELONGS 2"
    strSQL = "INSERT INTO ZZZ_BELONGS_TO ( c_belongs_to, c_addr_id, c_firstyear, c_lastyear ) " + _
                "SELECT DISTINCT TMP_ADDR_A.c_belongs_to, TMP_ADDR_A.c_addr_id, " + _
                    "TMP_ADDR_A.c_firstyear, TMP_ADDR_A.c_lastyear " + _
                "FROM TMP_ADDR_A"
    
    cmdSQL.CommandText = strSQL
    cmdSQL.Execute tRecNum
    
    '
    '  clean up everything
    
    cmdSQL.CommandText = " DELETE * FROM TMP_ADDR_A"
    cmdSQL.Execute tRecNum
    
    cmdSQL.CommandText = " DELETE * FROM TMP_ADDR_B"
    cmdSQL.Execute tRecNum
    
    cmdSQL.CommandText = " DELETE * FROM TMP_ADDR_C"
    cmdSQL.Execute tRecNum
    
    cmdSQL.CommandText = " DELETE * FROM TMP_ADDR_D"
    cmdSQL.Execute tRecNum
    
    cmdSQL.CommandText = " DELETE * FROM TMP_ADDR_E"
    cmdSQL.Execute tRecNum
    
End Sub
