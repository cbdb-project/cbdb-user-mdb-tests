        cmdSQL.Execute tRecProcessed
        
        tRuleTotal = tRecProcessed
        tTotal = tTotal + tRecProcessed
        
        cmdSQL.CommandText = tStrQuery(ti, 3)
        cmdSQL.Execute tRecProcessed
        
        tRuleTotal = tRuleTotal + tRecProcessed
        tTotal = tTotal + tRecProcessed
        
        MsgBox Str(tRuleTotal) + " records updated: Rule " + tStrQuery(ti, 4)
        
        '  just make sure the "Unknown" record does not get a value
        
        cmdSQL.CommandText = "UPDATE BIOG_MAIN SET BIOG_MAIN.c_index_year = 0, BIOG_MAIN.c_notes = '' " + _
            "WHERE (((BIOG_MAIN.c_personid)=0))"
        cmdSQL.Execute tRecProcessed

        ti = ti + 1
    Loop
    
    MsgBox Str(tTotal) + " total records updated"
    
End Sub
Private Sub GetBirthIndexYearSQL()
On Error GoTo ErrorGetBirthIndex

    Dim tTotal As Long, tTotalNew As Long, tStrCurrent As String, tLoopCount As Integer, strDynastyTest As String, strDynastyTest1 As String
    Dim cmdSQL As ADODB.Command, tRecProcessed As Long
    
    Set cmdSQL = New ADODB.Command
    cmdSQL.ActiveConnection = CurrentProject.Connection
    cmdSQL.CommandType = adCmdText
    '
    ' first set all index years to NULL
    
    cmdSQL.CommandText = "UPDATE BIOG_MAIN " + _
        "SET BIOG_MAIN.c_index_year = Null, " + _
            "BIOG_MAIN.c_index_year_type_code = '', " + _
            "BIOG_MAIN.c_index_year_source_id = NULL"
    cmdSQL.Execute tRecProcessed
    
    strDynastyTest = "(BIOG_MAIN.c_dy = 2 OR BIOG_MAIN.c_dy = 25 OR BIOG_MAIN.c_dy = 29 OR BIOG_MAIN.c_dy = 46 OR BIOG_MAIN.c_dy = 83)"
    strDynastyTest1 = "(BIOG_MAIN_1.c_dy = 2 OR BIOG_MAIN_1.c_dy = 25 OR BIOG_MAIN_1.c_dy = 29 OR BIOG_MAIN_1.c_dy = 46 OR BIOG_MAIN_1.c_dy = 83)"

    MsgBox "Rule 1 Birth Year"
    
    cmdSQL.CommandText = "UPDATE BIOG_MAIN " + _
        "SET BIOG_MAIN.c_index_year = [BIOG_MAIN].[c_birthyear], " + _
            "BIOG_MAIN.c_index_year_type_code = '01' " + _
        "WHERE (((BIOG_MAIN.c_birthyear)<>0) OR (BIOG_MAIN.c_birthyear = 0 AND " + strDynastyTest + "))"
    cmdSQL.Execute tRecProcessed
    tTotal = tRecProcessed
    
    MsgBox "Rule 2:  Death Year - Death Age"
    
    cmdSQL.CommandText = "UPDATE BIOG_MAIN " + _
        "SET BIOG_MAIN.c_index_year = [BIOG_MAIN].[c_deathyear]-[BIOG_MAIN].[c_death_age] + 1, " + _
            "BIOG_MAIN.c_index_year_type_code = '02' " + _
        "WHERE (((BIOG_MAIN.c_index_year) Is Null) AND ((BIOG_MAIN.c_deathyear)<>0 OR (BIOG_MAIN.c_deathyear = 0 AND " + strDynastyTest + ")) And " + _
            "((BIOG_MAIN.c_death_age)>0))"
    cmdSQL.Execute tRecProcessed
    tTotal = tTotal + tRecProcessed

    MsgBox "Rule 4W"
    ' Rule 4W:  Husband's index year (i.e. birth year or death year - death age + 1) + 3 (W or W1)
    '           Specifying the husband as 134 eliminates a handful of other relations, some of which are clearly coded incorrectly
    '           This is true for all calculations for wives and concubines

    cmdSQL.CommandText = "UPDATE (BIOG_MAIN AS BIOG_MAIN_1 INNER JOIN (BIOG_MAIN INNER JOIN KIN_DATA ON BIOG_MAIN.c_personid = KIN_DATA.c_personid) " + _
        "ON BIOG_MAIN_1.c_personid = KIN_DATA.c_kin_id) INNER JOIN KIN_DATA AS KIN_DATA_1 " + _
        "ON (BIOG_MAIN.c_personid = KIN_DATA_1.c_kin_id) AND (BIOG_MAIN_1.c_personid = KIN_DATA_1.c_personid) " + _
        "SET BIOG_MAIN.c_index_year_type_code = '03', " + _
            "BIOG_MAIN.c_index_year = [BIOG_MAIN_1].[c_index_year]+3, " + _
            "BIOG_MAIN.c_index_year_source_id = [BIOG_MAIN_1].[c_personid] " + _
        "WHERE ((BIOG_MAIN_1.c_index_year <> 0) Or (BIOG_MAIN_1.c_index_year = 0 And " + strDynastyTest1 + ")) And ((BIOG_MAIN.c_index_year) Is Null) " + _
            "AND ((KIN_DATA.c_kin_code)=134) AND ((KIN_DATA_1.c_kin_code)=135 Or KIN_DATA_1.c_kin_code = 138)"
    cmdSQL.Execute tRecProcessed
    tTotal = tTotal + tRecProcessed

    MsgBox "Rule 3: Male's death year"
    ' Rule 20: Person's death year:"  64 for men, 53 for women

    cmdSQL.CommandText = "UPDATE BIOG_MAIN " + _
            "SET BIOG_MAIN.c_index_year = [BIOG_MAIN].[c_deathyear]-64, " + _
                "BIOG_MAIN.c_index_year_type_code = '29' " + _
            "WHERE (((BIOG_MAIN.c_index_year) Is Null) AND ((BIOG_MAIN.c_deathyear)<> 0  OR (BIOG_MAIN.c_deathyear = 0 AND " + strDynastyTest + ")) " + _
                "AND ((BIOG_MAIN.c_female)=False));"
    cmdSQL.Execute tRecProcessed
    tTotal = tTotal + tRecProcessed

    MsgBox "Rule 3W: Female's death year"
    cmdSQL.CommandText = "UPDATE BIOG_MAIN " + _
            "SET BIOG_MAIN.c_index_year = [BIOG_MAIN].[c_deathyear]-53, " + _
                "BIOG_MAIN.c_index_year_type_code = '30' " + _
            "WHERE (((BIOG_MAIN.c_index_year) Is Null) AND ((BIOG_MAIN.c_deathyear)<> 0 OR (BIOG_MAIN.c_deathyear = 0 AND " + strDynastyTest + ")) " + _
                "AND ((BIOG_MAIN.c_female)=True));"
    cmdSQL.Execute tRecProcessed
    tTotal = tTotal + tRecProcessed

    MsgBox "Rule 5"
    ' Rule 5:  Jinshi year (year - 30), entry ype = "040101"

    cmdSQL.CommandText = "UPDATE ENTRY_CODE_TYPE_REL INNER JOIN (BIOG_MAIN INNER JOIN ENTRY_DATA ON BIOG_MAIN.c_personid = ENTRY_DATA.c_personid) " + _
        "ON ENTRY_CODE_TYPE_REL.c_entry_code = ENTRY_DATA.c_entry_code " + _
        "SET BIOG_MAIN.c_index_year = [ENTRY_DATA].[c_year]-30, " + _
            "BIOG_MAIN.c_index_year_type_code = '05' " + _
        "WHERE (((BIOG_MAIN.c_index_year) Is Null) AND ((ENTRY_DATA.c_year)>0) AND ((ENTRY_CODE_TYPE_REL.c_entry_type)='040101'))"
    cmdSQL.Execute tRecProcessed
    tTotal = tTotal + tRecProcessed

    MsgBox "Rule 5W"
    ' Rule 5W:  Husband's Jinshi year (year - 30 + 3)

    cmdSQL.CommandText = "UPDATE BIOG_MAIN AS WIFE_BIOG INNER JOIN ( ( ( ( BIOG_MAIN As husband_biog INNER JOIN ENTRY_DATA " + _
            "ON HUSBAND_BIOG.c_personid = ENTRY_DATA.c_personid ) INNER JOIN ENTRY_CODE_TYPE_REL " + _
            "ON ENTRY_DATA.c_entry_code = ENTRY_CODE_TYPE_REL.c_entry_code ) INNER JOIN KIN_DATA ON HUSBAND_BIOG.c_personid = KIN_DATA.c_personid ) " + _
            "INNER JOIN KIN_DATA AS KIN_DATA_1 ON HUSBAND_BIOG.c_personid = KIN_DATA_1.c_kin_id ) ON (WIFE_BIOG.c_personid = KIN_DATA.c_kin_id) " + _
            "AND (WIFE_BIOG.c_personid = KIN_DATA_1.c_personid) " + _
        "SET WIFE_BIOG.c_index_year = [ENTRY_DATA].[c_year] -27, " + _
            "WIFE_BIOG.c_index_year_type_code = '06', " + _
            "WIFE_BIOG.c_index_year_source_id = [husband_biog].[c_personid] " + _
        "WHERE ( ((WIFE_BIOG.c_index_year) IS NULL) AND ((WIFE_BIOG.c_female) = True) AND ((ENTRY_CODE_TYPE_REL.c_entry_type) = '040101') " + _
            "AND ((ENTRY_DATA.c_year)>0) AND ( (KIN_DATA.c_kin_code) = 135 OR (KIN_DATA.c_kin_code) = 138 ) AND ((KIN_DATA_1.c_kin_code) = 134) )"
    cmdSQL.Execute tRecProcessed
    tTotal = tTotal + tRecProcessed

    MsgBox "Rule 6"
    ' Rule 6:  Juren year (year - 27), entry type = "040102"

    cmdSQL.CommandText = "UPDATE ENTRY_CODE_TYPE_REL INNER JOIN (BIOG_MAIN INNER JOIN ENTRY_DATA ON BIOG_MAIN.c_personid = ENTRY_DATA.c_personid) " + _
        "ON ENTRY_CODE_TYPE_REL.c_entry_code = ENTRY_DATA.c_entry_code " + _
        "SET BIOG_MAIN.c_index_year = [ENTRY_DATA].[c_year]-27, " + _
            "BIOG_MAIN.c_index_year_type_code = '07' " + _
        "WHERE (((BIOG_MAIN.c_index_year) Is Null) AND ((ENTRY_DATA.c_year)>0) AND ((ENTRY_CODE_TYPE_REL.c_entry_type)='040102'))"
    cmdSQL.Execute tRecProcessed
    tTotal = tTotal + tRecProcessed
    
    MsgBox "Rule 6W"
    ' Rule 6W:  Husband's Juren year (year - 27 + 3)

    cmdSQL.CommandText = "UPDATE BIOG_MAIN AS WIFE_BIOG INNER JOIN ( ( ( ( BIOG_MAIN As husband_biog INNER JOIN ENTRY_DATA " + _
            "ON HUSBAND_BIOG.c_personid = ENTRY_DATA.c_personid ) INNER JOIN ENTRY_CODE_TYPE_REL " + _
            "ON ENTRY_DATA.c_entry_code = ENTRY_CODE_TYPE_REL.c_entry_code ) INNER JOIN KIN_DATA ON HUSBAND_BIOG.c_personid = KIN_DATA.c_personid ) " + _
            "INNER JOIN KIN_DATA AS KIN_DATA_1 ON HUSBAND_BIOG.c_personid = KIN_DATA_1.c_kin_id ) ON (WIFE_BIOG.c_personid = KIN_DATA.c_kin_id) " + _
            "AND (WIFE_BIOG.c_personid = KIN_DATA_1.c_personid) " + _
        "SET WIFE_BIOG.c_index_year = [ENTRY_DATA].[c_year] -24, " + _
            "WIFE_BIOG.c_index_year_type_code = '08', " + _
            "WIFE_BIOG.c_index_year_source_id = [husband_biog].[c_personid] " + _
        "WHERE ( ((WIFE_BIOG.c_index_year) IS NULL) AND ((WIFE_BIOG.c_female) = True) AND ((ENTRY_CODE_TYPE_REL.c_entry_type) = '040102') " + _
            "AND ((ENTRY_DATA.c_year)>0) AND ( (KIN_DATA.c_kin_code) = 135 OR (KIN_DATA.c_kin_code) = 138 ) AND ((KIN_DATA_1.c_kin_code) = 134) )"
    cmdSQL.Execute tRecProcessed
    tTotal = tTotal + tRecProcessed
    
    MsgBox "Rule 7"
    ' Rule 7:  Xiucai year (year - 21)

    cmdSQL.CommandText = "UPDATE ENTRY_CODE_TYPE_REL INNER JOIN (BIOG_MAIN INNER JOIN ENTRY_DATA ON BIOG_MAIN.c_personid = ENTRY_DATA.c_personid) " + _
        "ON ENTRY_CODE_TYPE_REL.c_entry_code = ENTRY_DATA.c_entry_code " + _
        "SET BIOG_MAIN.c_index_year = [ENTRY_DATA].[c_year]-21, " + _
            "BIOG_MAIN.c_index_year_type_code = '09' " + _
        "WHERE (((BIOG_MAIN.c_index_year) Is Null) AND ((ENTRY_DATA.c_year)>0) AND ((ENTRY_CODE_TYPE_REL.c_entry_type)='040103'))"
    cmdSQL.Execute tRecProcessed
    tTotal = tTotal + tRecProcessed

    MsgBox "Rule 7W"
    ' Rule 7W:  Husband's Xiucai year (year - 21 + 3)

    cmdSQL.CommandText = "UPDATE BIOG_MAIN AS WIFE_BIOG INNER JOIN ( ( ( ( BIOG_MAIN As husband_biog INNER JOIN ENTRY_DATA " + _
            "ON HUSBAND_BIOG.c_personid = ENTRY_DATA.c_personid ) INNER JOIN ENTRY_CODE_TYPE_REL " + _
            "ON ENTRY_DATA.c_entry_code = ENTRY_CODE_TYPE_REL.c_entry_code ) INNER JOIN KIN_DATA ON HUSBAND_BIOG.c_personid = KIN_DATA.c_personid ) " + _
            "INNER JOIN KIN_DATA AS KIN_DATA_1 ON HUSBAND_BIOG.c_personid = KIN_DATA_1.c_kin_id ) ON (WIFE_BIOG.c_personid = KIN_DATA.c_kin_id) " + _
            "AND (WIFE_BIOG.c_personid = KIN_DATA_1.c_personid) " + _
        "SET WIFE_BIOG.c_index_year = [ENTRY_DATA].[c_year] - 18, " + _
            "WIFE_BIOG.c_index_year_type_code = '10', " + _
            "WIFE_BIOG.c_index_year_source_id = [husband_biog].[c_personid] " + _
        "WHERE ( ((WIFE_BIOG.c_index_year) IS NULL) AND ((WIFE_BIOG.c_female) = True) AND ((ENTRY_CODE_TYPE_REL.c_entry_type) = '040103') " + _
            "AND ((ENTRY_DATA.c_year)>0) AND ( (KIN_DATA.c_kin_code) = 135 OR (KIN_DATA.c_kin_code) = 138 ) AND ((KIN_DATA_1.c_kin_code) = 134) )"
    cmdSQL.Execute tRecProcessed
    tTotal = tTotal + tRecProcessed
       
    MsgBox "Rule 8"
    ' Rule 8:  Father's birth year (year + 30)
    
    cmdSQL.CommandText = "UPDATE BIOG_MAIN AS BIOG_MAIN_1 INNER JOIN (BIOG_MAIN INNER JOIN KIN_DATA ON BIOG_MAIN.c_personid = KIN_DATA.c_kin_id) " + _
        "ON BIOG_MAIN_1.c_personid = KIN_DATA.c_personid " + _
        "SET BIOG_MAIN_1.c_index_year = [BIOG_MAIN].[c_birthyear]+ 30, " + _
            "BIOG_MAIN_1.c_index_year_type_code = '11', " + _
            "BIOG_MAIN_1.c_index_year_source_id = [BIOG_MAIN].[c_personid] " + _
        "WHERE (((BIOG_MAIN.c_birthyear)<> 0 OR (BIOG_MAIN.c_birthyear = 0 AND " + strDynastyTest + ")) AND ((BIOG_MAIN_1.c_index_year) Is Null) AND " + _
            "((KIN_DATA.c_kin_code)=75))"
    cmdSQL.Execute tRecProcessed
    tTotal = tTotal + tRecProcessed

    '  The rules that require finding the oldes or the youngest need a round-about way to proceed, since they need grouping and a min or max
    '  The strategy is to transfer the values to a temporary table and then update those to BIOG_MAIN
    '  This approach of using the max or min does not allow us to capture the ID of the corresponding person (since people are pooled to get the max/min)
    '  If the numbers are large enough and we need the IDs, we can change the algorith
    
    MsgBox "Starting the max/min searches."
    
    MsgBox "Rule 9"
    ' Rule 9:  Oldest Child's birth year (father) (year - 30)
    
    cmdSQL.CommandText = "DELETE * FROM TMP_INDEX_YEAR"
    cmdSQL.Execute tRecProcessed

    cmdSQL.CommandText = "INSERT INTO TMP_INDEX_YEAR ( c_personid, c_index_year ) " + _
        "SELECT BIOG_MAIN_1.c_personid, Min(BIOG_MAIN.c_birthyear) AS MinOfc_birthyear " + _
        "FROM BIOG_MAIN AS BIOG_MAIN_1 INNER JOIN (BIOG_MAIN INNER JOIN KIN_DATA ON " + _
        "BIOG_MAIN.c_personid = KIN_DATA.c_personid) ON BIOG_MAIN_1.c_personid = KIN_DATA.c_kin_id " + _
        "WHERE ((BIOG_MAIN_1.c_index_year) Is Null ) And " + _
            "((KIN_DATA.c_kin_code) = 75) And ((BIOG_MAIN.c_birthyear) <> 0 OR (BIOG_MAIN.c_birthyear = 0 AND " + strDynastyTest + ")) " + _
        "GROUP BY BIOG_MAIN_1.c_personid"
    cmdSQL.Execute tRecProcessed
        
    cmdSQL.CommandText = "UPDATE BIOG_MAIN INNER JOIN TMP_INDEX_YEAR ON BIOG_MAIN.c_personid = TMP_INDEX_YEAR.c_personid " + _
        "SET BIOG_MAIN.c_index_year = [TMP_INDEX_YEAR].[c_index_year]-30, " + _
            "BIOG_MAIN.c_index_year_type_code = '13' "
    cmdSQL.Execute tRecProcessed
    tTotal = tTotal + tRecProcessed

    MsgBox "Rule 9W"
    ' Rule 9W:  Oldest Child's birth year (mother) (year - 30 + 3)

    cmdSQL.CommandText = "DELETE * FROM TMP_INDEX_YEAR"
    cmdSQL.Execute tRecProcessed

    cmdSQL.CommandText = "INSERT INTO TMP_INDEX_YEAR ( c_personid, c_index_year ) " + _
        "SELECT BIOG_MAIN_1.c_personid, Min(BIOG_MAIN.c_birthyear) AS MinOfc_birthyear " + _
        "FROM BIOG_MAIN AS BIOG_MAIN_1 INNER JOIN (BIOG_MAIN INNER JOIN KIN_DATA ON " + _
        "BIOG_MAIN.c_personid = KIN_DATA.c_personid) ON BIOG_MAIN_1.c_personid = KIN_DATA.c_kin_id " + _
        "WHERE ((BIOG_MAIN_1.c_index_year) Is Null ) And " + _
            "((KIN_DATA.c_kin_code) = 111) And ((BIOG_MAIN.c_birthyear) <> 0 OR (BIOG_MAIN.c_birthyear = 0 AND " + strDynastyTest + ")) " + _
        "GROUP BY BIOG_MAIN_1.c_personid"
    cmdSQL.Execute tRecProcessed
        
    cmdSQL.CommandText = "UPDATE BIOG_MAIN INNER JOIN TMP_INDEX_YEAR ON BIOG_MAIN.c_personid = TMP_INDEX_YEAR.c_personid " + _
        "SET BIOG_MAIN.c_index_year = [TMP_INDEX_YEAR].[c_index_year]-27, " + _
            "BIOG_MAIN.c_index_year_type_code = '15' "
    cmdSQL.Execute tRecProcessed
    tTotal = tTotal + tRecProcessed
    
    MsgBox "Rule 4W Concubine"
    ' Now apply the rules for successor wives and concubines, AFTER 9W, which relies on their children's birth year
    ' Rule 4W:  Husband's index year (i.e. birth year or death year - death age + 1) + 3

    cmdSQL.CommandText = "UPDATE ( BIOG_MAIN As BIOG_MAIN_1 INNER JOIN ( BIOG_MAIN INNER JOIN KIN_DATA " + _
            "ON BIOG_MAIN.c_personid = KIN_DATA.c_personid ) ON BIOG_MAIN_1.c_personid = KIN_DATA.c_kin_id) " + _
            "INNER JOIN KIN_DATA AS KIN_DATA_1 ON (BIOG_MAIN.c_personid = KIN_DATA_1.c_kin_id) AND (BIOG_MAIN_1.c_personid = KIN_DATA_1.c_personid) " + _
        "SET BIOG_MAIN.c_index_year_type_code = '17', " + _
            "BIOG_MAIN.c_index_year = [BIOG_MAIN_1].[c_index_year] + 3, " + _
            "BIOG_MAIN.c_index_year_source_id = [BIOG_MAIN_1].[c_personid] " + _
        "WHERE ( (NOT ((BIOG_MAIN_1.c_index_year) IS NULL)) AND ((BIOG_MAIN.c_index_year) IS NULL) AND ((KIN_DATA.c_kin_code) = 134) ) " + _
            "AND ( (KIN_DATA_1.c_kin_code) = 168 OR (KIN_DATA_1.c_kin_code) = 163 OR (KIN_DATA_1.c_kin_code) = 344 " + _
            "OR (KIN_DATA_1.c_kin_code) = 467 OR (KIN_DATA_1.c_kin_code) = 585 )"
    cmdSQL.Execute tRecProcessed
    tTotal = tTotal + tRecProcessed

    MsgBox "Rule 5W Concubine"
    ' Rule 5W:  Husband's Jinshi year (year - 30 + 3)

    cmdSQL.CommandText = "UPDATE BIOG_MAIN AS WIFE_BIOG INNER JOIN ( ( ( ( BIOG_MAIN As husband_biog INNER JOIN ENTRY_DATA " + _
            "ON HUSBAND_BIOG.c_personid = ENTRY_DATA.c_personid ) INNER JOIN ENTRY_CODE_TYPE_REL " + _
            "ON ENTRY_DATA.c_entry_code = ENTRY_CODE_TYPE_REL.c_entry_code ) INNER JOIN KIN_DATA ON HUSBAND_BIOG.c_personid = KIN_DATA.c_personid ) " + _
            "INNER JOIN KIN_DATA AS KIN_DATA_1 ON HUSBAND_BIOG.c_personid = KIN_DATA_1.c_kin_id ) ON (WIFE_BIOG.c_personid = KIN_DATA.c_kin_id) " + _
            "AND (WIFE_BIOG.c_personid = KIN_DATA_1.c_personid) " + _
        "SET WIFE_BIOG.c_index_year = [ENTRY_DATA].[c_year] -27, " + _
            "WIFE_BIOG.c_index_year_type_code = '31', " + _
            "WIFE_BIOG.c_index_year_source_id = [husband_biog].[c_personid] " + _
        "WHERE ( ((WIFE_BIOG.c_index_year) IS NULL) AND ((WIFE_BIOG.c_female) = True) AND ((ENTRY_CODE_TYPE_REL.c_entry_type) = '040101') " + _
            "AND ((ENTRY_DATA.c_year)>0) AND ( (KIN_DATA.c_kin_code) = 168 OR (KIN_DATA.c_kin_code) = 163 OR (KIN_DATA.c_kin_code) = 344 " + _
            "OR (KIN_DATA.c_kin_code) = 467 OR (KIN_DATA.c_kin_code) = 585 ) AND ((KIN_DATA_1.c_kin_code) = 134) )"
    cmdSQL.Execute tRecProcessed
    tTotal = tTotal + tRecProcessed

    MsgBox "Rule 6W Concubine"
    ' Rule 6W:  Husband's Juren year (year - 27 + 3)

    cmdSQL.CommandText = "UPDATE BIOG_MAIN AS WIFE_BIOG INNER JOIN ( ( ( ( BIOG_MAIN As husband_biog INNER JOIN ENTRY_DATA " + _
            "ON HUSBAND_BIOG.c_personid = ENTRY_DATA.c_personid ) INNER JOIN ENTRY_CODE_TYPE_REL " + _
            "ON ENTRY_DATA.c_entry_code = ENTRY_CODE_TYPE_REL.c_entry_code ) INNER JOIN KIN_DATA ON HUSBAND_BIOG.c_personid = KIN_DATA.c_personid ) " + _
            "INNER JOIN KIN_DATA AS KIN_DATA_1 ON HUSBAND_BIOG.c_personid = KIN_DATA_1.c_kin_id ) ON (WIFE_BIOG.c_personid = KIN_DATA.c_kin_id) " + _
            "AND (WIFE_BIOG.c_personid = KIN_DATA_1.c_personid) " + _
        "SET WIFE_BIOG.c_index_year = [ENTRY_DATA].[c_year] -24, " + _
            "WIFE_BIOG.c_index_year_type_code = '32', " + _
            "WIFE_BIOG.c_index_year_source_id = [husband_biog].[c_personid] " + _
        "WHERE ( ((WIFE_BIOG.c_index_year) IS NULL) AND ((WIFE_BIOG.c_female) = True) AND ((ENTRY_CODE_TYPE_REL.c_entry_type) = '040102') " + _
            "AND ((ENTRY_DATA.c_year)>0) AND ( (KIN_DATA.c_kin_code) = 168 OR (KIN_DATA.c_kin_code) = 163 OR (KIN_DATA.c_kin_code) = 344 " + _
            "OR (KIN_DATA.c_kin_code) = 467 OR (KIN_DATA.c_kin_code) = 585 ) AND ((KIN_DATA_1.c_kin_code) = 134) )"
    cmdSQL.Execute tRecProcessed
    tTotal = tTotal + tRecProcessed
    
    MsgBox "Rule 7W Concubine"
    ' Rule 7W:  Husband's Xiucai year (year - 21 + 3)

    cmdSQL.CommandText = "UPDATE BIOG_MAIN AS WIFE_BIOG INNER JOIN ( ( ( ( BIOG_MAIN As husband_biog INNER JOIN ENTRY_DATA " + _
            "ON HUSBAND_BIOG.c_personid = ENTRY_DATA.c_personid ) INNER JOIN ENTRY_CODE_TYPE_REL " + _
            "ON ENTRY_DATA.c_entry_code = ENTRY_CODE_TYPE_REL.c_entry_code ) INNER JOIN KIN_DATA ON HUSBAND_BIOG.c_personid = KIN_DATA.c_personid ) " + _
            "INNER JOIN KIN_DATA AS KIN_DATA_1 ON HUSBAND_BIOG.c_personid = KIN_DATA_1.c_kin_id ) ON (WIFE_BIOG.c_personid = KIN_DATA.c_kin_id) " + _
            "AND (WIFE_BIOG.c_personid = KIN_DATA_1.c_personid) " + _
        "SET WIFE_BIOG.c_index_year = [ENTRY_DATA].[c_year] - 18, " + _
            "WIFE_BIOG.c_index_year_type_code = '33', " + _
            "WIFE_BIOG.c_index_year_source_id = [husband_biog].[c_personid] " + _
        "WHERE ( ((WIFE_BIOG.c_index_year) IS NULL) AND ((WIFE_BIOG.c_female) = True) AND ((ENTRY_CODE_TYPE_REL.c_entry_type) = '040103') " + _
            "AND ((ENTRY_DATA.c_year)>0) AND ( (KIN_DATA.c_kin_code) = 168 OR (KIN_DATA.c_kin_code) = 163 OR (KIN_DATA.c_kin_code) = 344 " + _
            "OR (KIN_DATA.c_kin_code) = 467 OR (KIN_DATA.c_kin_code) = 585 ) AND ((KIN_DATA_1.c_kin_code) = 134) )"
    cmdSQL.Execute tRecProcessed
    tTotal = tTotal + tRecProcessed

    MsgBox "Rule 10"
    ' Rule 10:  Youngest older brother's birth year (year + 2)

    cmdSQL.CommandText = "DELETE * FROM TMP_INDEX_YEAR"
    cmdSQL.Execute tRecProcessed

    cmdSQL.CommandText = "INSERT INTO TMP_INDEX_YEAR ( c_personid, c_index_year ) " + _
