            "GROUP BY BIOG_MAIN.c_personid"
        cmdSQL.Execute tRecProcessed
        
        cmdSQL.CommandText = "UPDATE BIOG_MAIN INNER JOIN TMP_INDEX_YEAR ON BIOG_MAIN.c_personid = TMP_INDEX_YEAR.c_personid " + _
