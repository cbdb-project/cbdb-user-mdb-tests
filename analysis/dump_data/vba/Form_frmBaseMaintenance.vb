Private Sub CmdDistance_Click()
    Dim cmdSQL As ADODB.Command, tRecCount As Long
    Dim tQueryStr As String
    
    Set cmdSQL = New ADODB.Command
    cmdSQL.ActiveConnection = CurrentProject.Connection
    cmdSQL.CommandType = adCmdText
    
    Me.TextFK.SetFocus
    Me.TextFK.Text = "Working on it."
    
    ' clear the tables
    
    cmdSQL.CommandText = "Delete * from TMP_DISTANCE_DATA"
    cmdSQL.Execute tRecCount
    
    cmdSQL.CommandText = "Delete * from ZZZ_DISTANCE_DATA"
    cmdSQL.Execute tRecCount
    
    ' first get the xy coordinates for the person and for the kin
    
    tQueryStr = "Insert INTO TMP_DISTANCE_DATA ( c_personid, c_assoc_id, x_coord, y_coord, assoc_xcoord, assoc_ycoord ) " + _
        "SELECT DISTINCT KIN_DATA.c_personid, KIN_DATA.c_kin_id, ADDR_CODES.x_coord, ADDR_CODES.y_coord, " + _
            "KIN_ADDR_CODES.x_coord, KIN_ADDR_CODES.y_coord " + _
        "FROM ( ( ( BIOG_MAIN INNER JOIN KIN_DATA ON BIOG_MAIN.c_personid = KIN_DATA.c_personid ) " + _
            "LEFT JOIN ADDR_CODES ON BIOG_MAIN.c_index_addr_id = ADDR_CODES.c_addr_id ) " + _
            "INNER JOIN BIOG_MAIN AS KIN_BIOG_DATA ON KIN_DATA.c_kin_id = KIN_BIOG_DATA.c_personid ) " + _
            "LEFT JOIN ADDR_CODES AS KIN_ADDR_CODES ON KIN_BIOG_DATA.c_index_addr_id = KIN_ADDR_CODES.c_addr_id"
    
    cmdSQL.CommandText = tQueryStr
    cmdSQL.Execute tRecCount
    
    ' then calculate the distance in two steps
    
    tQueryStr = "UPDATE TMP_DISTANCE_DATA SET TMP_DISTANCE_DATA.c_t_dist = " + _
        "Sqr((Sin(3.1415926536*(TMP_DISTANCE_DATA.y_coord-TMP_DISTANCE_DATA.assoc_ycoord)/360))^2+Cos(3.1415926536*TMP_DISTANCE_DATA.y_coord/180)*" + _
        "Cos(3.1415926536*TMP_DISTANCE_DATA.assoc_ycoord/180)*(Sin(3.1415926536*(TMP_DISTANCE_DATA.x_coord-TMP_DISTANCE_DATA.assoc_xcoord)/360))^2) " + _
        "WHERE (((TMP_DISTANCE_DATA.x_coord)>0) AND ((TMP_DISTANCE_DATA.y_coord)>0) AND " + _
        "((TMP_DISTANCE_DATA.assoc_xcoord)>0) AND ((TMP_DISTANCE_DATA.assoc_ycoord)>0));"
    
    cmdSQL.CommandText = tQueryStr
    cmdSQL.Execute tRecCount
    
    tQueryStr = "UPDATE TMP_DISTANCE_DATA SET TMP_DISTANCE_DATA.c_distance = " + _
        "25484*Atn(TMP_DISTANCE_DATA.c_t_dist/(1+Sqr(1-TMP_DISTANCE_DATA.c_t_dist*TMP_DISTANCE_DATA.c_t_dist))) " + _
        "WHERE (((TMP_DISTANCE_DATA.x_coord)>0) AND ((TMP_DISTANCE_DATA.y_coord)>0) AND " + _
        "((TMP_DISTANCE_DATA.assoc_xcoord)>0) AND ((TMP_DISTANCE_DATA.assoc_ycoord)>0))"

    cmdSQL.CommandText = tQueryStr
    cmdSQL.Execute tRecCount
    
    ' finally, transfer the results and clear the scratch table
    
    tQueryStr = "INSERT INTO ZZZ_DISTANCE_DATA (c_personid, c_assoc_id, c_distance) " + _
        "SELECT TMP_DISTANCE_DATA.c_personid, TMP_DISTANCE_DATA.c_assoc_id, TMP_DISTANCE_DATA.c_distance " + _
        "FROM TMP_DISTANCE_DATA " + _
        "WHERE (((TMP_DISTANCE_DATA.x_coord)>0) AND ((TMP_DISTANCE_DATA.y_coord)>0) AND " + _
        "((TMP_DISTANCE_DATA.assoc_xcoord)>0) AND ((TMP_DISTANCE_DATA.assoc_ycoord)>0));"
    
    cmdSQL.CommandText = tQueryStr
    cmdSQL.Execute tRecCount
    
    cmdSQL.CommandText = "Delete * from TMP_DISTANCE_DATA"
    cmdSQL.Execute tRecCount
    
    ' next get the xy coordinates for the person and for the associate
    
    tQueryStr = "INSERT INTO TMP_DISTANCE_DATA ( c_assoc_id, c_personid, x_coord, y_coord, assoc_xcoord, assoc_ycoord ) " + _
        "SELECT DISTINCT ASSOC_DATA.c_assoc_id, ASSOC_DATA.c_personid, ADDR_CODES.x_coord, " + _
            "ADDR_CODES.y_coord, ASSOC_ADDR_CODES.x_coord, ASSOC_ADDR_CODES.y_coord " + _
        "FROM ( ( ( ASSOC_DATA INNER JOIN BIOG_MAIN ON ASSOC_DATA.c_personid = BIOG_MAIN.c_personid ) " + _
            "LEFT JOIN ADDR_CODES ON BIOG_MAIN.c_index_addr_id = ADDR_CODES.c_addr_id ) " + _
            "INNER JOIN BIOG_MAIN AS ASSOC_BIOG_DATA ON ASSOC_DATA.c_assoc_id = ASSOC_BIOG_DATA.c_personid ) " + _
            "LEFT JOIN ADDR_CODES AS ASSOC_ADDR_CODES ON ASSOC_BIOG_DATA.c_index_addr_id = ASSOC_ADDR_CODES.c_addr_id;"
    
    cmdSQL.CommandText = tQueryStr
    cmdSQL.Execute tRecCount
    
    ' remove pairs where they already exist in ZZZ_DISTANCE_DATA
    
    tQueryStr = "UPDATE ZZZ_DISTANCE_DATA INNER JOIN TMP_DISTANCE_DATA ON ( ZZZ_DISTANCE_DATA.c_assoc_id = TMP_DISTANCE_DATA.c_assoc_id ) " + _
            "AND ( ZZZ_DISTANCE_DATA.c_personid = TMP_DISTANCE_DATA.c_personid ) " + _
        "SET TMP_DISTANCE_DATA.c_distance = 1;"
    
    cmdSQL.CommandText = tQueryStr
    cmdSQL.Execute tRecCount
    
    cmdSQL.CommandText = "Delete * from TMP_DISTANCE_DATA WHERE TMP_DISTANCE_DATA.c_distance = 1"
    cmdSQL.Execute tRecCount
    
    ' then calculate the distance in two steps
    
    tQueryStr = "UPDATE TMP_DISTANCE_DATA SET TMP_DISTANCE_DATA.c_t_dist = " + _
        "Sqr((Sin(3.1415926536*(TMP_DISTANCE_DATA.y_coord-TMP_DISTANCE_DATA.assoc_ycoord)/360))^2+Cos(3.1415926536*TMP_DISTANCE_DATA.y_coord/180)*" + _
        "Cos(3.1415926536*TMP_DISTANCE_DATA.assoc_ycoord/180)*(Sin(3.1415926536*(TMP_DISTANCE_DATA.x_coord-TMP_DISTANCE_DATA.assoc_xcoord)/360))^2) " + _
        "WHERE (((TMP_DISTANCE_DATA.x_coord)>0) AND ((TMP_DISTANCE_DATA.y_coord)>0) AND " + _
        "((TMP_DISTANCE_DATA.assoc_xcoord)>0) AND ((TMP_DISTANCE_DATA.assoc_ycoord)>0));"
    
    cmdSQL.CommandText = tQueryStr
    cmdSQL.Execute tRecCount
    
    tQueryStr = "UPDATE TMP_DISTANCE_DATA SET TMP_DISTANCE_DATA.c_distance = " + _
        "25484*Atn(TMP_DISTANCE_DATA.c_t_dist/(1+Sqr(1-TMP_DISTANCE_DATA.c_t_dist*TMP_DISTANCE_DATA.c_t_dist))) " + _
        "WHERE (((TMP_DISTANCE_DATA.x_coord)>0) AND ((TMP_DISTANCE_DATA.y_coord)>0) AND " + _
        "((TMP_DISTANCE_DATA.assoc_xcoord)>0) AND ((TMP_DISTANCE_DATA.assoc_ycoord)>0))"

    cmdSQL.CommandText = tQueryStr
    cmdSQL.Execute tRecCount
    
    ' finally, transfer the results and clear the scratch table
    
    tQueryStr = "INSERT INTO ZZZ_DISTANCE_DATA ( c_assoc_id, c_personid, c_distance ) " + _
        "SELECT TMP_DISTANCE_DATA.c_assoc_id, TMP_DISTANCE_DATA.c_personid, TMP_DISTANCE_DATA.c_distance " + _
        "FROM TMP_DISTANCE_DATA " + _
        "WHERE (((TMP_DISTANCE_DATA.x_coord)>0) AND ((TMP_DISTANCE_DATA.y_coord)>0) AND " + _
        "((TMP_DISTANCE_DATA.assoc_xcoord)>0) AND ((TMP_DISTANCE_DATA.assoc_ycoord)>0));"
    
    cmdSQL.CommandText = tQueryStr
    cmdSQL.Execute tRecCount
    
    MsgBox "Finished."
    
    Me.TextFK.Text = ""
    Me.CmdDistance.SetFocus
    

End Sub

