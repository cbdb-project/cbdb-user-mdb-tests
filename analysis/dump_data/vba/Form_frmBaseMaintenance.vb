    'MsgBox Str(tRecCount) + " records in E (B2)"
    '
    '  next get all the records where the BELONGS has no BELONGS
    '  the problem here is that many addresses in belonggs1_ID have two records, one of which has not c_belongs_to
    '  the dates here have to be tested.
    '
    tStrFrom = "FROM TMP_ADDR_E INNER JOIN TMP_ADDR_B ON TMP_ADDR_B.c_addr_id = TMP_ADDR_E.belongs4_ID "
    '
    tStrSelect = "SELECT DISTINCT TMP_ADDR_E.c_addr_id, TMP_ADDR_E.belongs1_ID, TMP_ADDR_E.belongs1_first_year, TMP_ADDR_E.belongs1_last_year, " + _
                    "TMP_ADDR_E.belongs2_ID, TMP_ADDR_E.belongs2_first_year, TMP_ADDR_E.belongs2_last_year, " + _
                    "TMP_ADDR_E.belongs3_ID, TMP_ADDR_E.belongs3_first_year, TMP_ADDR_E.belongs3_last_year, " + _
                    "TMP_ADDR_E.belongs4_ID, TMP_ADDR_E.belongs4_first_year, TMP_ADDR_E.belongs4_last_year, " + _
                    "TMP_ADDR_E.belongs_first_year, TMP_ADDR_E.belongs_last_year "
    tStrWhere = "WHERE ((TMP_ADDR_E.belongs4_ID Is Not Null) AND (TMP_ADDR_B.c_lastyear>=[TMP_ADDR_E].[belongs4_first_year]) " + _
                    "AND (TMP_ADDR_B.c_firstyear<=[TMP_ADDR_E].[belongs4_last_year]) AND (TMP_ADDR_B.c_belongs_to Is Null))"
    '
    cmdSQL.CommandText = tStrInsert + tStrSelect + tStrFrom + tStrWhere
    cmdSQL.Execute tRecCount
    'MsgBox Str(tRecCount) + " records in E (B2)"
    '
    '  Finally, get all the records where the BELONGS of the BELONGS fits within the time span of the address
    '  There are 4 possible records produced by the relationship:
    '       if D.first < B.first and B.last >= D.first and B.Last < D.last then
    '           (1) D/no B from D.first to B.first - 1,
    '           (2) D/B from B.first to B.Last
    '           (3) D/no B from B.Last + 1 to D.last
    '       if D.first >= B.first and D.first <= B.Last and B.last >= D.last then
    '           (1) D/B from D.first to D.Last
    '       if D.first >= B.first and D.first <= B.last and B.last < D.last then
    '           (1) D/B from D.first to B.Last
    '           (1) D/no B from B.last + 1 to D.last,
    '       if no overlap (B.Last < D.First or B.First > D.Last) then
    '           D/no B from D.first to D.Last
    '
    '  Situation 1 constraints (where the belongs relation in TMP_B starts AFTER the B1 belongs starts and ENDs before the B1 belongs ends)
    '       This creates 3 segments
    '
    tStrWhere = "WHERE ((TMP_ADDR_E.belongs_first_year<[TMP_ADDR_B].[c_belongs_first_year]) AND (TMP_ADDR_E.belongs_last_year>[TMP_ADDR_B].[c_belongs_last_year]) AND " + _
        "(TMP_ADDR_B.c_belongs_to Is Not Null))"
    '
    '  1 (a)
    '
