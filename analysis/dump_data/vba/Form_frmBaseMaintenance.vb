    cmdSQL.CommandText = tStrInsert + tStrSelect + tStrFrom + tStrWhere
    cmdSQL.Execute tRecCount
    '
    ' 1 (b)
    '
    'MsgBox "1 (b)"
    tStrInsert = "INSERT INTO TMP_ADDR_D ( c_addr_id, belongs1_ID, belongs1_first_year, belongs1_last_year, " + _
