Private Sub CmdSwap_Click()
On Error GoTo Err_CmdSwap_Click

    Dim tTableNamesRst As DAO.Recordset, tStartAt As Integer, tStrSQL As String
    Dim cmdSQL As ADODB.Command, tRecProcessed As Long
    
    Set tTableNamesRst = CurrentDb.OpenRecordset("CopyTables", dbOpenDynaset)
    
    '  in case I run into an error and need to start mid-stream
    
    Set cmdSQL = New ADODB.Command
    cmdSQL.ActiveConnection = CurrentProject.Connection
    cmdSQL.CommandType = adCmdText
    '
    With tTableNamesRst
        .MoveFirst
        Do While Not .EOF
            If !NotProcessed Then
                TxtCurrentTable.SetFocus
                TxtCurrentTable.Text = !TableName
                'cmdSQL.CommandText = "INSERT INTO " + !TableName + " SELECT " + !TableName + "1.* FROM " + !TableName + "1"
                tStrSQL = "INSERT INTO " + !TableName + " SELECT " + !TableName + "_link.* FROM " + !TableName + "_link"
                cmdSQL.CommandText = tStrSQL
                cmdSQL.Execute tRecProcessed
                
                'to remove link
                DoCmd.DeleteObject acTable, !TableName + "_link"
                
                'DoCmd.RunSQL tStrSQL
                'cmdSQL.CommandText = "Drop table " + !TableName + "1"
                'tStrSQL = "Drop table " + !TableName + "1"
                'cmdSQL.Execute tRecProcessed
                
                'cmdSQL.CommandText = tStrSQL
                'cmdSQL.Execute tRecProcessed
                'DoCmd.RunSQL tStrSQL
                .Edit
                !NotProcessed = False
                .Update
            End If
            .MoveNext
        Loop
        TxtCurrentTable.Text = "Finished: Please compact Database"
        CmdSwap.SetFocus
    End With
    
Exit_CmdSwap_Click:
    Exit Sub

Err_CmdSwap_Click:
    MsgBox Err.Description
    Resume Exit_CmdSwap_Click
    
End Sub