    "LookAtEntry", "LookAtStatus", "LookAtTexts", "LookAtPlace",
    "LookAtAssociations", "LookAtOffice", "LookAtKinship",
    "LookAtNetworks", "LookAtGroupData", "LookAtAssocPairs"
