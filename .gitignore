# --- Project-specific ----------------------------------------------------

# CBDB binaries are huge and proprietary. Ship paths, not data.
# Users obtain CBDB_BJ_User.mdb + CBDB_*_DATA.mdb + HelpFiles/ from CBDB
# (see README §Setup) and drop them under data/.
data/

# Per-test working copies, lock files, probe logs, and ad-hoc artefacts
# the analysis/ and tests/ scripts spew into analysis/.
analysis/_*
analysis/_exports_tmp/
# Exception: _data_mdb_finder.py is a committed shared utility module.
!analysis/_data_mdb_finder.py

# Bug-report capture working copies + lock files.
# (.docx outputs are GENERATED on demand by reports/generate_report.py
# and intentionally NOT committed — they're non-deterministic at the
# zip-timestamp level and would dirty every report regen.  The .md
# siblings are committed; reviewers / readers regenerate .docx
# locally if they want a Word file.)
reports/_*
reports/*.mdb
reports/*.ldb
reports/*.laccdb
reports/*.docx

# Real-export goldens that are blessed locally before the first push.
tests/golden/exports/_tmp/

# Local auto-memory (machine-specific assistant context, not portable).
memory/

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# --- Access ---------------------------------------------------------------
*.ldb           # JET lock file
*.laccdb        # ACE lock file
~$*.mdb         # Office temp lock

# --- Editor / OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Claude / agents ------------------------------------------------------
.claude/
